@page "/dbadmin"
@attribute [Authorize]

<PageHeader Title="数据库管理" Subtitle="数据浏览、表结构维护与 SQL 控制台">
    <PageHeaderExtra>
        <Space Size="@SpaceSize.Small">
            <SpaceItem>
                <Text>当前表</Text>
            </SpaceItem>
            <SpaceItem>
                <Select TItemValue="string"
                        TItem="string"
                        Style="min-width:220px"
                        Placeholder="暂无数据表"
                        Disabled="@(tables.Count == 0)"
                        Value="@currentTable?.Key"
                        ValueChanged="@HandleTableSelected">
                    @foreach (var table in tables)
                    {
                        <SelectOption Value="@table.Key" Label="@table.FullName">@table.FullName</SelectOption>
                    }
                </Select>
            </SpaceItem>
            <SpaceItem>
                <Button OnClick="RefreshTablesAsync">刷新结构</Button>
            </SpaceItem>
            <SpaceItem>
                <Button Type="ButtonType.Primary" Disabled="@(currentTable == null)" OnClick="OpenCreateDrawer">新增记录</Button>
            </SpaceItem>
            <SpaceItem>
                <Button OnClick="OpenCreateTableDrawer">新建表</Button>
            </SpaceItem>
            <SpaceItem>
                <Button Disabled="@(currentTable == null)" OnClick="OpenStructureDrawer">修改表结构</Button>
            </SpaceItem>
            <SpaceItem>
                <Button OnClick="OpenSqlDrawer">执行 SQL</Button>
            </SpaceItem>
            @if (currentTable != null)
            {
                <SpaceItem>
                    <Popconfirm Title="确认删除当前表？删除后数据无法恢复" OnConfirm="@DropCurrentTableAsync">
                        <Button Danger="true">删除当前表</Button>
                    </Popconfirm>
                </SpaceItem>
            }
        </Space>
    </PageHeaderExtra>
</PageHeader>

@if (tables.Count == 0)
{
    <Card>
        <Empty Description="@("当前数据库暂无表，可先创建一张表")" />
        <div class="bs-dbadmin-empty-actions">
            <Space>
                <SpaceItem>
                    <Button Type="ButtonType.Primary" OnClick="OpenCreateTableDrawer">新建表</Button>
                </SpaceItem>
                <SpaceItem>
                    <Button OnClick="OpenSqlDrawer">执行 SQL</Button>
                </SpaceItem>
            </Space>
        </div>
    </Card>
}
else if (currentTable == null)
{
    <Card>
        <Empty Description="@("请选择一个数据表")" />
    </Card>
}
else
{
    <div class="bs-dbadmin-shell">
        <Card Title="@currentTable.FullName">
            @if (!string.IsNullOrWhiteSpace(currentTable.Comment))
            {
                <div class="bs-dbadmin-comment">
                    <Text Type="@TextElementType.Secondary">@currentTable.Comment</Text>
                </div>
            }
            <Descriptions Column="4" Bordered="true">
                <DescriptionsItem Title="表类型">@currentTable.Type</DescriptionsItem>
                <DescriptionsItem Title="字段数">@currentTable.Columns.Count</DescriptionsItem>
                <DescriptionsItem Title="实体映射">@(currentTable.Entities.Count == 0 ? "无" : currentTable.Entities.Count.ToString())</DescriptionsItem>
                <DescriptionsItem Title="总记录数">@rowsRsp.Total</DescriptionsItem>
            </Descriptions>
        </Card>

        <Card>
            <div class="bs-dbadmin-section-title">
                <Text Strong="true">表数据</Text>
                <Space>
                    <SpaceItem>
                        <Button OnClick="ReloadCurrentTable">刷新数据</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="ButtonType.Primary" OnClick="OpenCreateDrawer">新增记录</Button>
                    </SpaceItem>
                </Space>
            </div>

            <Table TItem="BsDbAdminRowDto"
                   DataSource="@rowsRsp.Value"
                   Loading="@isLoading"
                   Total="@rowsRsp.Total"
                   PageIndex="@pageIndex"
                   PageSize="@pageSize"
                   PageIndexChanged="@HandlePageIndexChanged">
                @foreach (var column in currentTable.Columns)
                {
                    <Column @key="column.Name" TData="BsDbAdminRowDto" Title="@column.Name">@GetCellValue(context, column)</Column>
                }
                <ActionColumn Title="操作">
                    <Space Size="@SpaceSize.Small">
                        <SpaceItem>
                            <a @onclick="() => OpenEditDrawer(context)">编辑</a>
                        </SpaceItem>
                        <SpaceItem>
                            <Popconfirm Title="确认删除这条记录？" OnConfirm="@(() => DeleteRowAsync(context))">
                                <a class="bs-dbadmin-danger-link">删除</a>
                            </Popconfirm>
                        </SpaceItem>
                    </Space>
                </ActionColumn>
            </Table>
        </Card>

        <div class="bs-dbadmin-detail-grid">
            <Card>
                <div class="bs-dbadmin-section-title">
                    <Text Strong="true">字段结构</Text>
                    <Button OnClick="OpenStructureDrawer">修改表结构</Button>
                </div>

                <Table TItem="BsDbAdminTableColumnSchema" DataSource="@currentTable.Columns" HidePagination="true" Size="@TableSize.Small">
                    <PropertyColumn Property="c => c.Name" Title="字段" />
                    <PropertyColumn Property="c => c.DbTypeFull" Title="数据库类型" />
                    <PropertyColumn Property="c => c.ClrType" Title="CLR 类型" />
                    <Column TData="BsDbAdminTableColumnSchema" Title="约束">
                        @if (context.IsPrimary)
                        {
                            <Tag Color="@("gold")">主键</Tag>
                        }
                        @if (context.IsIdentity)
                        {
                            <Tag Color="@("purple")">自增</Tag>
                        }
                        <Tag Color="@(context.IsNullable ? "default" : "red")">@(context.IsNullable ? "可空" : "非空")</Tag>
                    </Column>
                    <PropertyColumn Property="c => c.DefaultValue" Title="默认值" />
                    <Column TData="BsDbAdminTableColumnSchema" Title="实体说明">
                        @if (context.EntityBindings.Count == 0)
                        {
                            <Tag Color="@("default")">无实体映射</Tag>
                        }
                        else
                        {
                            @foreach (var binding in context.EntityBindings)
                            {
                                <Tag Color="@("blue")">@($"{binding.EntityName}.{binding.PropertyName}")</Tag>
                            }
                        }
                    </Column>
                </Table>
            </Card>

            <Card>
                <div class="bs-dbadmin-section-title">
                    <Text Strong="true">实体说明</Text>
                </div>

                @if (currentTable.Entities.Count == 0)
                {
                    <Empty Description="@("当前表没有实体映射")" />
                }
                else
                {
                    <Space Direction="@SpaceDirection.Vertical" Size="@SpaceSize.Small" Style="width:100%">
                        @foreach (var entity in currentTable.Entities)
                        {
                            <Descriptions Column="1" Bordered="true" Title="@entity.EntityName">
                                <DescriptionsItem Title="映射到">@entity.FullTableName</DescriptionsItem>
                                <DescriptionsItem Title="实体字段数">@entity.Columns.Count</DescriptionsItem>
                                @if (GetEntityOnlyColumns(entity).Any())
                                {
                                    <DescriptionsItem Title="仅实体字段">
                                        @foreach (var missing in GetEntityOnlyColumns(entity))
                                        {
                                            <Tag Color="@("orange")">@($"{missing}（实体有，表里无）")</Tag>
                                        }
                                    </DescriptionsItem>
                                }
                            </Descriptions>
                        }
                    </Space>
                }
            </Card>
        </div>
    </div>
}

<Drawer Closable="true"
        Width="720"
        Visible="@drawerVisible"
        Title="@drawerTitle"
        OnClose="CloseDrawer">
    <AntDesign.Template>
        @if (editingTable != null)
        {
            <Form TModel="object" Layout="@FormLayout.Vertical">
                @foreach (var field in editFields)
                {
                    <FormItem Label="@field.Column.Name">
                        <div class="bs-dbadmin-field-meta">
                            <Text Type="@TextElementType.Secondary">@($"{field.Column.DbTypeFull} / {field.Column.ClrType}")</Text>
                            @if (field.Column.IsPrimary)
                            {
                                <Tag Color="@("gold")">主键</Tag>
                            }
                            @if (field.Column.IsIdentity)
                            {
                                <Tag Color="@("purple")">自增</Tag>
                            }
                            @foreach (var binding in field.Column.EntityBindings)
                            {
                                <Tag Color="@("blue")">@($"{binding.EntityName}.{binding.PropertyName}")</Tag>
                            }
                        </div>

                        @if (field.Column.IsBoolean)
                        {
                            <Checkbox @bind-Checked="field.BoolValue" Disabled="@field.ReadOnly" />
                        }
                        else
                        {
                            <Input @bind-Value="field.Value" Disabled="@field.ReadOnly" />
                        }
                    </FormItem>
                }

                <FormItem>
                    <div class="bs-dbadmin-form-actions">
                        <Button OnClick="CloseDrawer">取消</Button>
                        <Button Type="ButtonType.Primary" Loading="@isSaving" OnClick="SaveAsync">保存</Button>
                    </div>
                </FormItem>
            </Form>
        }
    </AntDesign.Template>
</Drawer>

<Drawer Closable="true"
        Width="640"
        Visible="@createTableDrawerVisible"
        Title="@("新建数据表")"
        OnClose="CloseCreateTableDrawer">
    <AntDesign.Template>
        <Form TModel="object" Layout="@FormLayout.Vertical">
            <FormItem Label="表名">
                <Input Placeholder="例如 Users 或 dbo.Users" @bind-Value="createTableName" />
            </FormItem>

            <FormItem Label="字段定义">
                <TextArea Rows="6" @bind-Value="createTableDefinition" />
                <div class="bs-dbadmin-form-tip">
                    <Text Type="@TextElementType.Secondary">按数据库原生 SQL 定义字段，例如：Id INTEGER PRIMARY KEY AUTOINCREMENT, Name TEXT NOT NULL</Text>
                </div>
            </FormItem>

            <FormItem>
                <div class="bs-dbadmin-form-actions">
                    <Button OnClick="CloseCreateTableDrawer">取消</Button>
                    <Button OnClick="GenerateCreateTableSql">写入 SQL 控制台</Button>
                    <Button Type="ButtonType.Primary" OnClick="CreateTableAsync">创建表</Button>
                </div>
            </FormItem>
        </Form>
    </AntDesign.Template>
</Drawer>

<Drawer Closable="true"
        Width="820"
        Visible="@structureDrawerVisible"
        Title="@($"修改表结构 - {currentTable?.FullName}")"
        OnClose="CloseStructureDrawer">
    <AntDesign.Template>
        @if (currentTable != null)
        {
            <div class="bs-dbadmin-current-columns">
                @foreach (var column in currentTable.Columns)
                {
                    <Tag Color="@("geekblue")">@column.Name</Tag>
                }
            </div>

            <Row Gutter="16">
                <AntDesign.Col Span="12" Xs="24" Md="12">
                    <Card Size="@CardSize.Small" Title="新增字段">
                        <Form TModel="object" Layout="@FormLayout.Vertical">
                            <FormItem Label="字段定义">
                                <TextArea Rows="4" @bind-Value="addColumnDefinition" />
                            </FormItem>
                        </Form>
                        <div class="bs-dbadmin-form-actions">
                            <Button Type="ButtonType.Primary" OnClick="AddColumnAsync">直接执行</Button>
                            <Button OnClick="GenerateAddColumnSql">写入 SQL</Button>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="12" Xs="24" Md="12">
                    <Card Size="@CardSize.Small" Title="重命名字段">
                        <Form TModel="object" Layout="@FormLayout.Vertical">
                            <FormItem Label="原字段名">
                                <Input @bind-Value="renameOldColumnName" />
                            </FormItem>
                            <FormItem Label="新字段名">
                                <Input @bind-Value="renameNewColumnName" />
                            </FormItem>
                        </Form>
                        <div class="bs-dbadmin-form-actions">
                            <Button Type="ButtonType.Primary" OnClick="RenameColumnAsync">直接执行</Button>
                            <Button OnClick="GenerateRenameColumnSql">写入 SQL</Button>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="12" Xs="24" Md="12">
                    <Card Size="@CardSize.Small" Title="删除字段">
                        <Form TModel="object" Layout="@FormLayout.Vertical">
                            <FormItem Label="字段名">
                                <Input @bind-Value="dropColumnName" />
                            </FormItem>
                        </Form>
                        <div class="bs-dbadmin-form-actions">
                            <Button Danger="true" OnClick="DropColumnAsync">直接执行</Button>
                            <Button OnClick="GenerateDropColumnSql">写入 SQL</Button>
                        </div>
                    </Card>
                </AntDesign.Col>

                <AntDesign.Col Span="12" Xs="24" Md="12">
                    <Card Size="@CardSize.Small" Title="修改字段 SQL 模板">
                        <Form TModel="object" Layout="@FormLayout.Vertical">
                            <FormItem Label="字段名">
                                <Input @bind-Value="alterColumnName" />
                            </FormItem>
                            <FormItem Label="新定义">
                                <Input Placeholder="例如 Name TEXT NOT NULL" @bind-Value="alterColumnDefinition" />
                            </FormItem>
                        </Form>
                        <div class="bs-dbadmin-form-actions">
                            <Button OnClick="GenerateAlterColumnSql">生成 SQL</Button>
                        </div>
                    </Card>
                </AntDesign.Col>
            </Row>
        }
    </AntDesign.Template>
</Drawer>

<Drawer Closable="true"
        Width="960"
        Visible="@sqlDrawerVisible"
        Title="@("SQL 控制台")"
        OnClose="CloseSqlDrawer">
    <AntDesign.Template>
        <TextArea Rows="10" class="bs-dbadmin-sql-editor" @bind-Value="sqlText" />
        <div class="bs-dbadmin-form-actions">
            <Button Type="ButtonType.Primary" Loading="@isExecutingSql" OnClick="ExecuteSqlAsync">执行 SQL</Button>
            <Button OnClick="ClearSqlResult">清空结果</Button>
        </div>

        @if (sqlResult != null)
        {
            <Alert Type="@AlertType.Info" Message="@sqlResult.Message" ShowIcon="true" style="margin:12px 0" />

            @if (sqlResult.IsQuery)
            {
                <Table TItem="Dictionary<string, string?>" DataSource="@sqlResult.Rows" HidePagination="true" Size="@TableSize.Small">
                    @foreach (var column in sqlResult.Columns)
                    {
                        <Column @key="column" TData="Dictionary<string, string?>" Title="@column">@GetSqlCellValue(context, column)</Column>
                    }
                </Table>
            }
        }
    </AntDesign.Template>
</Drawer>
