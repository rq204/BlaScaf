@page "/users"
@attribute [Authorize]

<PageHeader Title="@("用户管理")" Subtitle="@($"数量：{this.userrsp.Total}")">
    <PageHeaderExtra>
        <Button OnClick="NewDrawer">添加用户</Button>
    </PageHeaderExtra>
</PageHeader>

<Table @ref="table" Loading="@isloading" TItem="BsUser" DataSource="@this.userrsp.Value" PageSize="15" Total="@this.userrsp.Total" PageIndexChanged="@PageIndexChange" PageIndex="@pageIndex">
    <PropertyColumn Property="c=>c.UserId" Title="用户ID" />
    <PropertyColumn Title="用户名" Property="c=>c.UserName" />
    @if (this.showFullName)
    {
        <PropertyColumn Title="姓名" Property="c=>c.FullName" />
    }
    <PropertyColumn Title="角色" Property="c=>c.Role" />
    <PropertyColumn Title="添加时间" Property="c=>c.AddTime" Format="yyyy-MM-dd HH:mm:ss" />
    <PropertyColumn Title="最后登录" Property="c=>c.LastLogin" Format="yyyy-MM-dd HH:mm:ss" />
    <PropertyColumn Title="过期时间" Property="c=>c.EndTime" Format="yyyy-MM-dd HH:mm:ss" />
    <PropertyColumn Title="状态" Property="c=>c.Enable" />
    @foreach (var field in BsConfig.UserEditorFields)
    {
        <PropertyColumn Title="@field.DisplayName" Property="c => GetUserFieldDisplayValue(c, field)" />
    }
    <ActionColumn Title="操作">
        <Space Size="SpaceSize.Middle">
            @if (BsConfig.UserAuthFragment != null)
            {
                <SpaceItem>
                    <a @onclick="()=>SetUserAuth(context)">权限</a>
                </SpaceItem>
            }
            <SpaceItem>
                <a @onclick="()=>OnEdit(context)">编辑</a>
            </SpaceItem>
        </Space>
    </ActionColumn>
</Table>

<Drawer Closable="true" Width="480" Visible="@drawerVisible" Title="@editTitle" OnClose="CloseDrawer">
    <AntDesign.Template style="height:90%">
        <Row>
            <AntDesign.Col Span="24">
                <Text>用户名</Text>
                <Input Placeholder="请输入用户名" @bind-Value="@editUser.UserName" />
            </AntDesign.Col>
        </Row>
        <br />
        <Row>
            <AntDesign.Col Span="24">
                <Text>姓  名</Text>
                <Input Placeholder="请输入姓名" @bind-Value="@editUser.FullName" />
            </AntDesign.Col>
        </Row>
        <br />
        <Row>
            <AntDesign.Col Span="24">
                <Text>密  码</Text>
                <InputPassword Placeholder="新增用户请输入密码，编辑用户留空则保持原密码" @bind-Value="@editUser.Password" />
            </AntDesign.Col>
        </Row>
        <br />
        <Row>
            <AntDesign.Col Span="24">
                <Text>角  色</Text><br />
                <Select TItemValue="string" TItem="string" Style="width:100%" @bind-Value="editUser.Role">
                    @foreach (var role in BsConfig.Roles)
                    {
                        <SelectOption Value="@role" Label="@role">@role</SelectOption>
                    }
                </Select>
            </AntDesign.Col>
        </Row>
        <br />
        @if (BsConfig.UserEditorFields.Count > 0)
        {
            @foreach (var field in BsConfig.UserEditorFields)
            {
                <Row>
                    <AntDesign.Col Span="24">
                        <Text>@field.DisplayName</Text><br />
                        @switch (field.ControlType)
                        {
                            case BsUserEditorFieldControlType.String:
                                <Input Placeholder="@($"请输入{field.DisplayName}")"
                                       @bind-Value:get="GetStringFieldValue(field)"
                                       @bind-Value:set="value => SetStringFieldValue(field, value)" />
                                break;
                            case BsUserEditorFieldControlType.Int:
                                <AntDesign.InputNumber TValue="int"
                                                       Style="width:100%"
                                                       @bind-Value:get="GetIntFieldValue(field)"
                                                       @bind-Value:set="value => SetIntFieldValue(field, value)" />
                                break;
                            case BsUserEditorFieldControlType.Bool:
                                <Switch @bind-Checked:get="GetBoolFieldValue(field)"
                                        @bind-Checked:set="value => SetBoolFieldValue(field, value)" />
                                break;
                            case BsUserEditorFieldControlType.ListString:
                                <Select TItemValue="string"
                                        TItem="string"
                                        Style="width:100%"
                                        @bind-Value:get="GetStringFieldValue(field)"
                                        @bind-Value:set="value => SetStringFieldValue(field, value)">
                                    @foreach (var option in GetListOptions(field))
                                    {
                                        <SelectOption Value="@option" Label="@option">@option</SelectOption>
                                    }
                                </Select>
                                break;
                        }
                    </AntDesign.Col>
                </Row>
                <br />
            }
        }
        <Row>
            <AntDesign.Col Span="24">
                <Text>过期时间</Text><br />
                <DatePicker @bind-Value="@editUser.EndTime" TValue="DateTime" Format="yyyy/MM/dd">
                </DatePicker>
            </AntDesign.Col>
        </Row>
        <br />
        <Row>
            <AntDesign.Col Span="24">
                <Text>启用</Text><br />
                <Switch @bind-Checked="editUser.Enable" />
            </AntDesign.Col>
        </Row>
        <br />

        <Row>
            <AntDesign.Col Span="24">
                <Button Type="ButtonType.Primary" OnClick="@SaveUser" Style="float:right">保存</Button>
            </AntDesign.Col>
        </Row>
    </AntDesign.Template>
</Drawer>

@if (_userFragment != null)
{
    @_userFragment
}
